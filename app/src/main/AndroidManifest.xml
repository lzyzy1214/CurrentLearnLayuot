<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CurrentLearnLayuot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChapterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SystemBarDemoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.CurrentLearnLayuot.SystemBarDemo" />

        <activity
            android:name=".ViewTreeInfoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".XmlInflationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".XmlInflationDemoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".viewload.ViewLoadHubActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".viewload.ActivityLoadActivity"
            android:exported="false"
            android:parentActivityName=".viewload.ViewLoadHubActivity" />

        <activity
            android:name=".viewload.FragmentLoadActivity"
            android:exported="false"
            android:parentActivityName=".viewload.ViewLoadHubActivity" />

        <activity
            android:name=".viewload.AdapterLoadActivity"
            android:exported="false"
            android:parentActivityName=".viewload.ViewLoadHubActivity" />

        <activity
            android:name=".viewload.PlainActivityProofActivity"
            android:exported="false"
            android:parentActivityName=".viewload.ViewLoadHubActivity"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".xmlflow.XmlLoadingFlowHubActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".xmlflow.XmlLoadingIntroActivity"
            android:exported="false"
            android:parentActivityName=".xmlflow.XmlLoadingFlowHubActivity" />

        <activity
            android:name=".xmlflow.DocFlowActivity"
            android:exported="false"
            android:parentActivityName=".xmlflow.XmlLoadingFlowHubActivity" />
    </application>

</manifest>